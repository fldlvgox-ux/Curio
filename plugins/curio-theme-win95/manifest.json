{
  "id": "curio-theme-win95",
  "name": "Windows 95",
  "version": "1.0.0",
  "type": "theme",
  "contract": "1.0.0",
  "author": "Microsoft (Aesthetic replica for Curio)",
  "description": "Authentic Windows 95 gray 3D bevels, sunken inputs, teal desktop background, and classic titlebars.",
  "family": "retro-os",
  "preview": "preview.png",
  "files": {
    "css": "theme.css"
  },
  "tokens": {
    "--bg": "#008080",
    "--surface": "#c0c0c0",
    "--surface-2": "#d4d0c8",
    "--text": "#000000",
    "--text-dim": "#4a4a4a",
    "--accent": "#000080",
    "--accent-text": "#ffffff",
    "--border": "#808080",
    "--select-bg": "#000080",
    "--select-fg": "#ffffff",
    "--danger": "#990000",
    "--ok": "#008000",
    "--warn": "#808000",
    "--font-ui": "Tahoma, 'MS Sans Serif', 'Segoe UI', Arial, sans-serif",
    "--font-display": "Tahoma, 'MS Sans Serif', sans-serif",
    "--font-mono": "'Fixedsys', 'Consolas', 'Courier New', monospace",
    "--font-size-base": "12px",
    "--font-smoothing": "auto",
    "--space-1": "3px",
    "--space-2": "6px",
    "--space-3": "10px",
    "--space-4": "14px",
    "--space-5": "20px",
    "--row-height": "28px",
    "--control-height": "26px",
    "--pixel-scale": "1",
    "--radius-window": "0px",
    "--radius-control": "0px",
    "--radius-chip": "0px",
    "--avatar-shape": "0px",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#ffffff",
    "--bevel-dark": "#404040",
    "--bevel-width": "2px",
    "--shadow-raised": "inset 1px 1px #ffffff, inset -1px -1px #000000, inset 2px 2px #dfdfdf, inset -2px -2px #808080",
    "--shadow-pressed": "inset 1px 1px #000000, inset -1px -1px #ffffff, inset 2px 2px #808080, inset -2px -2px #dfdfdf",
    "--shadow-hard": "1px 1px 0px #000000",
    "--gradient-title": "linear-gradient(90deg, #000080, #1084d0)",
    "--gradient-button": "none",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "1px dotted #000080",
    "--default-button-ring": "1px solid #000000"
  },
  "palettes": {
    "default": {},
    "desert": {
      "--bg": "#d4b896",
      "--surface": "#e0d0b8",
      "--accent": "#704828"
    }
  }
}
