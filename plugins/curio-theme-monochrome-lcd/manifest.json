{
  "id": "curio-theme-monochrome-lcd",
  "name": "Monochrome LCD",
  "version": "1.0.0",
  "type": "theme",
  "author": "Curio Retro Labs",
  "description": "Nokia / Game Boy monochrome LCD screen. Pale olive-green LCD paper, dark olive ink text, LCD pixel cell grid overlay, and flat pixelated controls. Authentic retro phone display aesthetic.",
  "family": "retro",
  "entry": "theme.css",
  "tokens": {
    "--bg": "#8B956D",
    "--surface": "#97A378",
    "--surface-2": "#7D8662",
    "--text": "#2B2F1E",
    "--text-dim": "#4A5035",
    "--accent": "#3A3F2C",
    "--accent-text": "#C5CF9F",
    "--border": "#5C6347",
    "--select-bg": "#4A5035",
    "--select-fg": "#C5CF9F",
    "--danger": "#3A2A1E",
    "--ok": "#2B3A1E",
    "--warn": "#4A4020",
    "--font-ui": "'Courier New', Courier, 'Lucida Console', monospace",
    "--font-display": "'Courier New', Courier, monospace",
    "--font-mono": "'Courier New', Courier, 'Lucida Console', monospace",
    "--font-size-base": "13px",
    "--font-smoothing": "none",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--row-height": "32px",
    "--control-height": "28px",
    "--pixel-scale": "1",
    "--radius-window": "2px",
    "--radius-control": "2px",
    "--radius-chip": "2px",
    "--avatar-shape": "2px",
    "--cut-tl": "0",
    "--cut-tr": "0",
    "--cut-br": "0",
    "--cut-bl": "0",
    "--bevel-light": "#A8B38A",
    "--bevel-dark": "#5C6347",
    "--bevel-width": "2px",
    "--shadow-raised": "2px 2px 0 #5C6347",
    "--shadow-pressed": "inset 2px 2px 0 #5C6347",
    "--shadow-hard": "3px 3px 0 #4A5035",
    "--gradient-title": "none",
    "--gradient-button": "none",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px #2B2F1E",
    "--default-button-ring": "0 0 0 1px #2B2F1E"
  }
}
