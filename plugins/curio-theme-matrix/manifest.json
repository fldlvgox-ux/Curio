{
  "id": "curio-theme-matrix",
  "name": "Matrix Terminal",
  "version": "1.0.0",
  "type": "theme",
  "contract": "1.0.0",
  "author": "Curio Core",
  "description": "Phosphor-green on black — a hacker terminal aesthetic for your collection.",
  "family": "studio-palette",
  "preview": null,
  "files": { "css": "theme.css" },
  "tokens": {
    "--bg": "#030804",
    "--surface": "#08140a",
    "--surface-2": "#0e2011",
    "--text": "#ecfdf5",
    "--text-dim": "#6ee7b7",
    "--accent": "#10b981",
    "--accent-text": "#ffffff",
    "--border": "#142e18",
    "--select-bg": "#10b981",
    "--select-fg": "#ffffff",
    "--danger": "#ef4444",
    "--ok": "#10b981",
    "--warn": "#eab308",
    "--font-ui": "inherit",
    "--font-display": "inherit",
    "--font-mono": "inherit",
    "--font-size-base": "13px",
    "--font-smoothing": "antialiased",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--row-height": "32px",
    "--control-height": "28px",
    "--pixel-scale": "1",
    "--radius-window": "8px",
    "--radius-control": "6px",
    "--radius-chip": "12px",
    "--avatar-shape": "50%",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "transparent",
    "--bevel-dark": "transparent",
    "--bevel-width": "0px",
    "--shadow-raised": "0 2px 8px rgba(16, 185, 129, 0.15)",
    "--shadow-pressed": "inset 0 1px 3px rgba(0,0,0,0.3)",
    "--shadow-hard": "none",
    "--gradient-title": "none",
    "--gradient-button": "none",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px rgba(16, 185, 129, 0.5)",
    "--default-button-ring": "0 0 0 2px rgba(16, 185, 129, 0.3)"
  }
}
