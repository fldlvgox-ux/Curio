{
  "id": "curio-theme-starter",
  "name": "Starter Template",
  "version": "1.0.0",
  "type": "theme",
  "contract": "1.0.0",
  "author": "Curio Author",
  "description": "Baseline template demonstrating full Curio theme contract conformance.",
  "family": "custom",
  "preview": "preview.png",
  "files": {
    "css": "theme.css"
  },
  "tokens": {
    "--bg": "#090d16",
    "--surface": "#111726",
    "--surface-2": "#182238",
    "--text": "#f1f5f9",
    "--text-dim": "#94a3b8",
    "--accent": "#06b6d4",
    "--accent-text": "#ffffff",
    "--border": "#1e293b",
    "--select-bg": "#3b82f6",
    "--select-fg": "#ffffff",
    "--danger": "#f43f5e",
    "--ok": "#10b981",
    "--warn": "#f59e0b",
    "--font-ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "--font-display": "inherit",
    "--font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "--font-size-base": "14px",
    "--font-smoothing": "antialiased",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--row-height": "36px",
    "--control-height": "32px",
    "--pixel-scale": "1",
    "--radius-window": "12px",
    "--radius-control": "6px",
    "--radius-chip": "999px",
    "--avatar-shape": "50%",
    "--cut-tl": "0",
    "--cut-tr": "0",
    "--cut-br": "0",
    "--cut-bl": "0",
    "--bevel-light": "transparent",
    "--bevel-dark": "transparent",
    "--bevel-width": "0",
    "--shadow-raised": "0 2px 8px rgba(0,0,0,0.3)",
    "--shadow-pressed": "inset 0 2px 4px rgba(0,0,0,0.3)",
    "--shadow-hard": "none",
    "--gradient-title": "none",
    "--gradient-button": "none",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px var(--accent)",
    "--default-button-ring": "none"
  },
  "palettes": {
    "default": {}
  }
}
