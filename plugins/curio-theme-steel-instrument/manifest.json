{
  "id": "curio-theme-steel-instrument",
  "name": "Steel-Blue Instrument Panel",
  "version": "1.0.0",
  "type": "theme",
  "author": "Curio Audio Engineering",
  "description": "Winamp Modern / Bento brushed steel-blue audio rack with glowing electric-cyan LCD readouts, cassette reel monogram covers, and tactile metallic transport keycaps.",
  "family": "instrument",
  "entry": "theme.css",
  "tokens": {
    "--bg": "#080E18",
    "--surface": "#0B1320",
    "--surface-2": "#121D2E",
    "--text": "#F0F6FF",
    "--text-dim": "#8CA4C4",
    "--accent": "#00E5FF",
    "--accent-text": "#060C16",
    "--border": "#2B3D55",
    "--select-bg": "#1D4E89",
    "--select-fg": "#FFFFFF",
    "--danger": "#FF3366",
    "--ok": "#00FFA3",
    "--warn": "#FFB800",
    "--font-ui": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "--font-display": "ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace",
    "--font-mono": "ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace",
    "--font-size-base": "13px",
    "--font-smoothing": "antialiased",
    "--space-1": "3px",
    "--space-2": "6px",
    "--space-3": "10px",
    "--space-4": "14px",
    "--space-5": "20px",
    "--row-height": "30px",
    "--control-height": "28px",
    "--pixel-scale": "1",
    "--radius-window": "4px",
    "--radius-control": "3px",
    "--radius-chip": "12px",
    "--avatar-shape": "4px",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#E8F0FA",
    "--bevel-dark": "#1C2A3D",
    "--bevel-width": "2px",
    "--shadow-raised": "0 2px 6px rgba(0,0,0,0.5), inset 1px 1px 0 rgba(255,255,255,0.7)",
    "--shadow-pressed": "inset 2px 2px 4px rgba(0,0,0,0.7), inset -1px -1px 0 rgba(255,255,255,0.15)",
    "--shadow-hard": "none",
    "--gradient-title": "linear-gradient(180deg, #E6EFF8 0%, #A8BCCE 100%)",
    "--gradient-button": "linear-gradient(180deg, #FFFFFF 0%, #D8E5F4 40%, #A4B8CF 100%)",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px #00E5FF",
    "--default-button-ring": "0 0 4px #00E5FF"
  }
}
