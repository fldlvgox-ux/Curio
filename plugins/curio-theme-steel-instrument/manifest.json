{
  "id": "curio-theme-steel-instrument",
  "name": "Steel-Blue Instrument Panel",
  "version": "1.0.0",
  "type": "theme",
  "author": "Curio Audio Engineering",
  "description": "Winamp-style brushed steel-blue audio rack with glowing electric-cyan LCD readouts, graphic equalizer faders, and tactile transport controls.",
  "family": "instrument",
  "entry": "theme.css",
  "tokens": {
    "--bg": "#0B1019",
    "--surface": "#C5D0E0",
    "--surface-2": "#131C2B",
    "--text": "#0E1726",
    "--text-dim": "#52627A",
    "--accent": "#00E5FF",
    "--accent-text": "#08101E",
    "--border": "#4B5E7A",
    "--select-bg": "#1D4E89",
    "--select-fg": "#FFFFFF",
    "--danger": "#FF3366",
    "--ok": "#00FFA3",
    "--warn": "#FFB800",
    "--font-ui": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "--font-display": "ui-monospace, 'SF Mono', Monaco, Consolas, monospace",
    "--font-mono": "ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace",
    "--font-size-base": "13px",
    "--font-smoothing": "antialiased",
    "--space-1": "3px",
    "--space-2": "6px",
    "--space-3": "10px",
    "--space-4": "14px",
    "--space-5": "20px",
    "--row-height": "30px",
    "--control-height": "28px",
    "--pixel-scale": "1",
    "--radius-window": "4px",
    "--radius-control": "3px",
    "--radius-chip": "12px",
    "--avatar-shape": "4px",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#E8F0FA",
    "--bevel-dark": "#324055",
    "--bevel-width": "2px",
    "--shadow-raised": "0 2px 6px rgba(0,0,0,0.4), inset 1px 1px 0 rgba(255,255,255,0.7)",
    "--shadow-pressed": "inset 2px 2px 4px rgba(0,0,0,0.6), inset -1px -1px 0 rgba(255,255,255,0.2)",
    "--shadow-hard": "none",
    "--gradient-title": "linear-gradient(180deg, #2D3D58 0%, #172233 100%)",
    "--gradient-button": "linear-gradient(180deg, #DCE5F2 0%, #B0C0D6 50%, #95A7C0 100%)",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px #00E5FF",
    "--default-button-ring": "0 0 4px #00E5FF"
  }
}
