{
  "id": "curio-theme-steel-instrument",
  "name": "Steel-Blue Instrument Panel",
  "version": "2.0.0",
  "type": "theme",
  "author": "Curio Audio Engineering",
  "description": "Authentic Winamp Modern / Bento brushed steel-blue audio rack. Open periwinkle studio canvas, light aluminium faceplates, convex circular transport buttons, and glowing cyan LCD readouts.",
  "family": "instrument",
  "entry": "theme.css",
  "tokens": {
    "--bg": "#D5DDE8",
    "--surface": "#DCE6F2",
    "--surface-2": "#0C1524",
    "--text": "#0B1524",
    "--text-dim": "#485A72",
    "--accent": "#00A8CC",
    "--accent-text": "#FFFFFF",
    "--border": "#6B7F98",
    "--select-bg": "#1D5496",
    "--select-fg": "#FFFFFF",
    "--danger": "#D92550",
    "--ok": "#00A86B",
    "--warn": "#D98200",
    "--font-ui": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "--font-display": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "--font-mono": "ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace",
    "--font-size-base": "13px",
    "--font-smoothing": "antialiased",
    "--space-1": "3px",
    "--space-2": "6px",
    "--space-3": "10px",
    "--space-4": "14px",
    "--space-5": "20px",
    "--row-height": "28px",
    "--control-height": "26px",
    "--pixel-scale": "1",
    "--radius-window": "6px",
    "--radius-control": "14px",
    "--radius-chip": "12px",
    "--avatar-shape": "4px",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#FFFFFF",
    "--bevel-dark": "#758AA2",
    "--bevel-width": "1.5px",
    "--shadow-raised": "0 2px 5px rgba(20,35,55,0.25), inset 1px 1px 0 #FFFFFF, inset -1px -1px 0 #8FA2B8",
    "--shadow-pressed": "inset 2px 2px 4px rgba(10,20,35,0.5), inset -1px -1px 0 rgba(255,255,255,0.4)",
    "--shadow-hard": "none",
    "--gradient-title": "linear-gradient(180deg, #1C2B3E 0%, #2B3D55 100%)",
    "--gradient-button": "radial-gradient(circle at 35% 35%, #FFFFFF 0%, #DDE8F4 45%, #ABC0D6 85%, #859BB2 100%)",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px #00A8CC",
    "--default-button-ring": "0 0 4px #00A8CC"
  }
}
