{
  "id": "curio-theme-pixel-8bit",
  "name": "8-Bit Pixel RPG",
  "version": "1.0.0",
  "type": "theme",
  "author": "Curio Arcade Lab",
  "description": "Authentic 8-bit / 16-bit 2D pixel video game aesthetic. Hard-stepped pixel borders, zero border-radius, zero blur, classic RPG dialogue box frames, item inventory slots, and chunky pixelated controls.",
  "family": "game",
  "entry": "theme.css",
  "tokens": {
    "--bg": "#121526",
    "--surface": "#1a2035",
    "--surface-2": "#262f4d",
    "--text": "#ffffff",
    "--text-dim": "#9badb7",
    "--accent": "#f3c669",
    "--accent-text": "#121526",
    "--border": "#000000",
    "--select-bg": "#3b5dc9",
    "--select-fg": "#ffffff",
    "--danger": "#e43b44",
    "--ok": "#38b764",
    "--warn": "#feae34",
    "--font-ui": "'Courier New', Courier, 'Lucida Console', monospace",
    "--font-display": "'Courier New', Courier, monospace",
    "--font-mono": "'Courier New', Courier, 'Lucida Console', monospace",
    "--font-size-base": "12px",
    "--font-smoothing": "none",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--row-height": "32px",
    "--control-height": "28px",
    "--pixel-scale": "2",
    "--radius-window": "0px",
    "--radius-control": "0px",
    "--radius-chip": "0px",
    "--avatar-shape": "0%",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#5b6ee1",
    "--bevel-dark": "#000000",
    "--bevel-width": "2px",
    "--shadow-raised": "3px 3px 0 #000000, inset 2px 2px 0 #5b6ee1, inset -2px -2px 0 #0d1527",
    "--shadow-pressed": "inset 3px 3px 0 #000000",
    "--shadow-hard": "4px 4px 0 #000000",
    "--gradient-title": "none",
    "--gradient-button": "none",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px #f3c669",
    "--default-button-ring": "0 0 0 2px #000000"
  }
}
