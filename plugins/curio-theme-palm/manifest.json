{
  "id": "curio-theme-palm",
  "name": "Palm OS / PDA",
  "version": "1.0.0",
  "type": "theme",
  "contract": "1.0.0",
  "author": "Palm Computing (Aesthetic replica for Curio)",
  "description": "Palm OS / PalmPilot PDA monochrome LCD aesthetic with 4-shade grayscale and pixel borders.",
  "family": "retro-handheld",
  "preview": "preview.png",
  "files": {
    "css": "theme.css"
  },
  "tokens": {
    "--bg": "#d8d8ce",
    "--surface": "#e5e5dc",
    "--surface-2": "#f5f5ee",
    "--text": "#000000",
    "--text-dim": "#444444",
    "--accent": "#000000",
    "--accent-text": "#ffffff",
    "--border": "#aaaa99",
    "--select-bg": "#000000",
    "--select-fg": "#ffffff",
    "--danger": "#000000",
    "--ok": "#000000",
    "--warn": "#444444",
    "--font-ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "--font-display": "sans-serif",
    "--font-mono": "'Courier New', Courier, monospace",
    "--font-size-base": "12px",
    "--font-smoothing": "none",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--row-height": "28px",
    "--control-height": "24px",
    "--pixel-scale": "1",
    "--radius-window": "4px",
    "--radius-control": "2px",
    "--radius-chip": "4px",
    "--avatar-shape": "2px",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#ffffff",
    "--bevel-dark": "#666655",
    "--bevel-width": "1px",
    "--shadow-raised": "none",
    "--shadow-pressed": "none",
    "--shadow-hard": "none",
    "--gradient-title": "none",
    "--gradient-button": "none",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px #000000",
    "--default-button-ring": "0 0 0 1px #000000"
  }
}
