{
  "id": "curio-theme-winxp",
  "name": "Windows XP Luna",
  "version": "1.0.0",
  "type": "theme",
  "contract": "1.0.0",
  "author": "Microsoft (Aesthetic replica for Curio)",
  "description": "Windows XP Luna Blue with cheerful taskbar gradients, rounded plastic window frames, and 3D buttons.",
  "family": "retro-os",
  "preview": "preview.png",
  "files": {
    "css": "theme.css"
  },
  "tokens": {
    "--bg": "#245edb",
    "--surface": "#ece9d8",
    "--surface-2": "#ffffff",
    "--text": "#000000",
    "--text-dim": "#444444",
    "--accent": "#0054e3",
    "--accent-text": "#ffffff",
    "--border": "#7f9db9",
    "--select-bg": "#316ac5",
    "--select-fg": "#ffffff",
    "--danger": "#c95742",
    "--ok": "#228b22",
    "--warn": "#d2691e",
    "--font-ui": "'Tahoma', 'Segoe UI', Arial, sans-serif",
    "--font-display": "'Tahoma', sans-serif",
    "--font-mono": "'Lucida Console', 'Courier New', monospace",
    "--font-size-base": "12px",
    "--font-smoothing": "antialiased",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--row-height": "32px",
    "--control-height": "28px",
    "--pixel-scale": "1",
    "--radius-window": "6px",
    "--radius-control": "3px",
    "--radius-chip": "10px",
    "--avatar-shape": "50%",
    "--cut-tl": "0px",
    "--cut-tr": "0px",
    "--cut-br": "0px",
    "--cut-bl": "0px",
    "--bevel-light": "#ffffff",
    "--bevel-dark": "#7f9db9",
    "--bevel-width": "1px",
    "--shadow-raised": "0 2px 4px rgba(0, 34, 102, 0.2)",
    "--shadow-pressed": "inset 0 1px 3px rgba(0, 0, 0, 0.3)",
    "--shadow-hard": "none",
    "--gradient-title": "linear-gradient(180deg, #0a246a 0%, #a6caf0 100%)",
    "--gradient-button": "linear-gradient(180deg, #ffffff 0%, #ece9d8 100%)",
    "--grain": "none",
    "--dither-pattern": "none",
    "--focus-ring": "0 0 0 2px rgba(0, 84, 227, 0.5)",
    "--default-button-ring": "0 0 0 2px #0054e3"
  }
}
